# ==============================================================================
# Frontend Dockerfile - PRODUCCIÓN (multi-stage)
# Stage 1: compila la SPA con Vite
# Stage 2: sirve el build estático con nginx:alpine
# ==============================================================================

# --- Stage 1: build ---
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# VITE_API_URL se bake en el bundle en tiempo de build (Vite no tiene runtime env)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npx vite build

# --- Stage 2: serve ---
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
