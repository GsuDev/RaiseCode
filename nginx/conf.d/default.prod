# ==============================================================================
# Code Judge Platform - Nginx Reverse Proxy - PRODUCCIÓN
# Diferencias respecto a default.conf (dev):
#   - upstream frontend apunta al contenedor nginx:alpine (puerto 80), no a Vite
#   - location / sirve la SPA estática sin headers de HMR/WebSocket
# ==============================================================================

# ==============================================================================
# SERVER BLOCK 1: HTTP (puerto 80) — Redirección a HTTPS
# ==============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name localhost;

    # Resolución dinámica via DNS interno de Docker
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $upstream_frontend frontend:80;
    set $upstream_api      api:3000;

    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    location ~ /\.(env|git|htaccess|gitignore|dockerignore) {
        deny all;
        return 403;
    }

    location ~ \.(sql|bak|backup|old|conf|config|log)$ {
        deny all;
        return 403;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ==============================================================================
# SERVER BLOCK 2: HTTPS (puerto 443) — SSL + Proxy
# ==============================================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name localhost;

    # Resolución dinámica via DNS interno de Docker
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $upstream_frontend frontend:80;
    set $upstream_api      api:3000;

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ==================================================================
    # Cabeceras de seguridad HTTP
    # ==================================================================

    # X-Frame-Options: DENY
    # Impide que la página se cargue dentro de un <iframe> en cualquier
    # origen. Previene ataques de clickjacking, donde un atacante
    # superpone la app en un iframe invisible para engañar al usuario.
    add_header X-Frame-Options "DENY" always;

    # X-Content-Type-Options: nosniff
    # Evita que el navegador intente "adivinar" el tipo MIME de una
    # respuesta ignorando el Content-Type declarado. Sin esta cabecera,
    # un archivo de texto podría ejecutarse como JS si el navegador lo
    # infiere incorrectamente (MIME sniffing attack).
    add_header X-Content-Type-Options "nosniff" always;

    # X-XSS-Protection: 1; mode=block
    # Activa el filtro XSS integrado en navegadores antiguos (IE, Chrome
    # legacy). Al detectar un ataque XSS reflejado, bloquea la página en
    # lugar de intentar sanearla. Los navegadores modernos usan CSP, pero
    # esta cabecera protege a los usuarios con browsers desactualizados.
    add_header X-XSS-Protection "1; mode=block" always;

    # Referrer-Policy: strict-origin-when-cross-origin
    # Controla qué información se envía en el header Referer al navegar.
    # - Mismo origen: envía URL completa (path + query).
    # - Origen cruzado con HTTPS→HTTPS: envía solo el origen (dominio).
    # - HTTPS→HTTP (downgrade): no envía nada. Protege datos sensibles
    #   en la URL (tokens, IDs) de filtrarse a sitios de terceros.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Content-Security-Policy (CSP)
    # Política de seguridad de contenido: define los orígenes válidos
    # desde los que se pueden cargar recursos (scripts, estilos, imágenes,
    # fuentes, conexiones, etc.). Mitiga ataques XSS almacenado y la
    # carga de recursos maliciosos inyectados.
    # - default-src 'self'        → por defecto, solo recursos del mismo origen
    # - script-src  'self'        → scripts solo del mismo origen (sin inline en prod)
    # - style-src   'self' 'unsafe-inline'  → estilos inline necesarios para Chakra UI
    # - img-src     'self' data:            → imágenes locales y data URIs (avatares SVG)
    # - connect-src 'self' wss:             → fetch/XHR al propio origen y WebSockets (Socket.IO)
    # - font-src    'self'                  → fuentes solo del mismo origen
    # - frame-ancestors 'none'              → refuerza X-Frame-Options a nivel CSP
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss:; font-src 'self'; frame-ancestors 'none'" always;

    # Permissions-Policy
    # Restringe el acceso a APIs sensibles del navegador.
    # Se desactivan explícitamente las siguientes para que ningún script
    # de la página (incluidos los de terceros inyectados) pueda usarlas:
    # - camera        → acceso a la cámara
    # - microphone    → acceso al micrófono
    # - geolocation   → acceso a la ubicación GPS
    # - payment       → API de pagos del navegador
    # - usb           → acceso a dispositivos USB
    # - fullscreen    → modo pantalla completa sin interacción del usuario
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)" always;

    client_max_body_size 10M;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;

    # ==================================================================
    # Health Check
    # ==================================================================
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    location ~ /\.(env|git|htaccess|gitignore|dockerignore) {
        deny all;
        return 403;
    }

    location ~ \.(sql|bak|backup|old|conf|config|log)$ {
        deny all;
        return 403;
    }

    # ==================================================================
    # Rate Limiting — Autenticación
    # ==================================================================
    location /api/auth/login {
        limit_req zone=auth burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/auth/register {
        limit_req zone=auth burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://$upstream_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ==================================================================
    # Socket.IO WebSocket — antes de /api/ para que nginx lo capture primero
    # ==================================================================
    location /socket.io/ {
        proxy_pass http://$upstream_api;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_request_buffering off;

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # ==================================================================
    # API Backend
    # ==================================================================
    location /api/ {
        proxy_pass http://$upstream_api;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering off;
        proxy_request_buffering off;
    }

    # ==================================================================
    # Frontend — SPA estática (nginx:alpine, sin HMR)
    # ==================================================================
    location / {
        proxy_pass http://$upstream_frontend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }
}
