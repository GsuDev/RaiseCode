# ==============================================================================
# Code Judge Platform - Nginx Reverse Proxy - PRODUCCIÓN
# Diferencias respecto a default.conf (dev):
#   - upstream frontend apunta al contenedor nginx:alpine (puerto 80), no a Vite
#   - location / sirve la SPA estática sin headers de HMR/WebSocket
# ==============================================================================

# Upstream para el Frontend (nginx sirviendo el build estático)
upstream frontend {
    server frontend:80;
}

# Upstream para la API (NestJS)
upstream api {
    server api:3000;
}

# ==============================================================================
# SERVER BLOCK 1: HTTP (puerto 80) — Redirección a HTTPS
# ==============================================================================
server {
    listen 80;
    listen [::]:80;
    server_name localhost;

    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    location ~ /\.(env|git|htaccess|gitignore|dockerignore) {
        deny all;
        return 403;
    }

    location ~ \.(sql|bak|backup|old|conf|config|log)$ {
        deny all;
        return 403;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ==============================================================================
# SERVER BLOCK 2: HTTPS (puerto 443) — SSL + Proxy
# ==============================================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name localhost;

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 10M;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;

    # ==================================================================
    # Health Check
    # ==================================================================
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    location ~ /\.(env|git|htaccess|gitignore|dockerignore) {
        deny all;
        return 403;
    }

    location ~ \.(sql|bak|backup|old|conf|config|log)$ {
        deny all;
        return 403;
    }

    # ==================================================================
    # Rate Limiting — Autenticación
    # ==================================================================
    location /api/auth/login {
        limit_req zone=auth burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/auth/register {
        limit_req zone=auth burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ==================================================================
    # Socket.IO WebSocket — antes de /api/ para que nginx lo capture primero
    # ==================================================================
    location /socket.io/ {
        proxy_pass http://api;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_request_buffering off;

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # ==================================================================
    # API Backend
    # ==================================================================
    location /api/ {
        proxy_pass http://api;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering off;
        proxy_request_buffering off;
    }

    # ==================================================================
    # Frontend — SPA estática (nginx:alpine, sin HMR)
    # ==================================================================
    location / {
        proxy_pass http://frontend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }
}
