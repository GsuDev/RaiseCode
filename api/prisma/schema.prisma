// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// Modelos sin Foreign keys

model AppConfig {
  key   String @id
  value String
}

model Course {
  id             Int             @id @default(autoincrement())
  name           String
  users          User[]
  subjectCourses SubjectCourse[]
}

model Dificulty {
  id         Int         @id @default(autoincrement())
  name       String
  // Relaciones de Dificulty
  challenges Challenge[]
}

model Language {
  id         Int         @id @default(autoincrement())
  name       String
  // Relaciones de Language
  challenges Challenge[]
}

model Subject {
  id             Int              @id @default(autoincrement())
  name           String
  description    String           @default("")
  // Relaciones de Subject
  challenges     Challenge[]
  userSubjects   UserSubjects[]
  subjectCourses SubjectCourse[]
}

model SubjectCourse {
  subject   Subject @relation(fields: [subjectId], references: [id])
  subjectId Int
  course    Course  @relation(fields: [courseId], references: [id])
  courseId  Int

  @@id([subjectId, courseId])
}

model User {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  name                 String
  lastname             String
  password             String
  
  // Relación con Course
  course               Course                @relation(fields: [courseId], references: [id])
  courseId             Int

  // Relaciones de User
  createdChallenges    Challenge[]           @relation("ChallengeCreator")
  validatedChallenges  Challenge[]           @relation("ChallengeValidator")
  completedChallenges  CompletedChallenges[]
  userRoles            UserRoles[]
  userAchievements     UserAchievements[]
  userSubjects         UserSubjects[]

  xp                   Int                   @default(0)
}

model Role {
  id        Int         @id @default(autoincrement())
  name      String
  // Relaciones de Role
  userRoles UserRoles[]
}

model Achievement {
  id               Int                @id @default(autoincrement())
  name             String
  // Relaciones de Achievement
  userAchievements UserAchievements[]
  description      String
  xpReward         Int                @default(0)
}

// Modelos de las tablas intermedias de User

model UserRoles {
  user   User @relation(fields: [userId], references: [id])
  userId Int
  role   Role @relation(fields: [roleId], references: [id])
  roleId Int

  @@id([userId, roleId])
}

model UserAchievements {
  user          User        @relation(fields: [userId], references: [id])
  userId        Int
  achivement    Achievement @relation(fields: [achievementId], references: [id])
  achievementId Int
  unlockedAt    DateTime    @default(now())

  @@id([userId, achievementId])
}

model UserSubjects {
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  subject   Subject @relation(fields: [subjectId], references: [id])
  subjectId Int

  @@id([userId, subjectId])
}

// Modelo de Challenges

model Challenge {
  id                  Int                   @id @default(autoincrement())
  title               String
  description         String
  statement           String                @db.VarChar(1500)
  dificulty           Dificulty             @relation(fields: [dificultyId], references: [id])
  dificultyId         Int
  language            Language              @relation(fields: [languageId], references: [id])
  languageId          Int
  subject             Subject               @relation(fields: [subjectId], references: [id])
  subjectId           Int
  creator             User                  @relation("ChallengeCreator", fields: [creatorId], references: [id])
  creatorId           Int
  validator           User                  @relation("ChallengeValidator", fields: [validatorId], references: [id])
  validatorId         Int
  validate            Boolean
  completedChallenges CompletedChallenges[]
  tests               ChallengeTest[]       // ← NUEVO
}

// Modelo de ChallengeTest — tests de validación del reto

model ChallengeTest {
  id             Int       @id @default(autoincrement())
  challenge      Challenge @relation(fields: [challengeId], references: [id])
  challengeId    Int
  input          String    @db.Text
  expectedOutput String    @db.Text
  hidden         Boolean   @default(false)
}

// Modelo de CompletedChallenges

model CompletedChallenges {
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  challengeId Int
  time        BigInt
  Code        String    @db.VarChar(1500)
  completedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@id([userId, challengeId])
}