# ==============================================================================
# CODE JUDGE PLATFORM - VARIABLES DE ENTORNO (DESARROLLO)
# ==============================================================================
# Copia este archivo como .env: cp .env.example .env

# ==============================================================================
# GENERAL
# ==============================================================================
COMPOSE_PROJECT_NAME=code_judge
TIMEZONE=Europe/Madrid

# Versiones de lenguajes/frameworks
NODE_VERSION=20
PYTHON_VERSION=3.11

# ==============================================================================
# NGINX (Reverse Proxy)
# ==============================================================================
NGINX_VERSION=alpine
NGINX_PORT=80

# ==============================================================================
# FRONTEND (Vite + React)
# ==============================================================================
# URL de la API para el frontend
FRONTEND_API_URL=http://localhost/api

# Puerto interno del contenedor (Vite default)
FRONTEND_INTERNAL_PORT=5173

# Puerto externo expuesto en el host
FRONTEND_EXTERNAL_PORT=5173

# ==============================================================================
# API (NestJS + Yarn)
# ==============================================================================
# Puerto interno y externo de la API
API_PORT=3000
API_EXTERNAL_PORT=3000

# JWT
JWT_SECRET=dev_secret_not_for_production_use_only
JWT_EXPIRATION=7d

# ==============================================================================
# WORKER (Python + Flask)
# ==============================================================================
# Puerto del Worker
WORKER_PORT=4000
WORKER_EXTERNAL_PORT=4000

# Límites de ejecución
RUNNER_TIMEOUT=10
RUNNER_MEMORY_LIMIT=256m
RUNNER_CPU_LIMIT=0.5

# ==============================================================================
# MARIADB
# ==============================================================================
MARIADB_VERSION=11.2

DB_URL="mysql://root:root@mariadb:3306/raisecode"
DB_HOST="mariadb"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="root"
DB_NAME="raisecode"

# Puerto externo (para debugging desde host)
DB_EXTERNAL_PORT=3306

# Performance
DB_MAX_CONNECTIONS=200
DB_BUFFER_POOL_SIZE=256M

# ==============================================================================
# MONGODB
# ==============================================================================
MONGO_VERSION=7.0

# Variables de la base de datos Mongo
MONGO_URL="mongodb://127.0.0.1:27017/raisecode"
MONGO_HOST="127.0.0.1"
MONGO_PORT=27017
MONGO_USER="raise"
MONGO_PASSWORD="raise"
MONGO_NAME="raisecode"

# Puerto externo (para debugging desde host)
MONGO_EXTERNAL_PORT=27017

# ==============================================================================
# REDIS
# ==============================================================================
REDIS_VERSION=7-alpine

REDIS_HOST=redis
REDIS_PORT=6379

# Puerto externo (para debugging desde host)
REDIS_EXTERNAL_PORT=6379

# Memory
REDIS_MAX_MEMORY=256mb

# ==============================================================================
# NOTAS
# ==============================================================================
#
# PUERTOS:
# --------
# Nginx:        80 (acceso principal)
# Frontend:     5173 (directo al contenedor)
# API:          3000 (directo al contenedor)
# Worker:       4000 (directo al contenedor)
# MariaDB:      3306 (desde host)
# MongoDB:      27017 (desde host)
# Redis:        6379 (desde host)
#
# ACCESO:
# -------
# Web:          http://localhost
# API:          http://localhost/api
# Frontend:     http://localhost:5173 (directo)
# API:          http://localhost:3000 (directo)
# Worker:       http://localhost:4000 (directo)
#
# HOT-RELOAD:
# -----------
# Todos los servicios tienen hot-reload activado
# Los cambios en código se reflejan automáticamente
#
# ==============================================================================
